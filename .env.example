# --- Server & Core Runtime ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Database (Persistent MongoDB) ---
# In production, must be an authenticated persistent replica set or cluster URI
MONGODB_URI=mongodb://127.0.0.1:27017/aurumsave

# --- Authentication & Session Security ---
# In production, MUST be at least 32 cryptographically secure characters; insecure defaults rejected on startup
JWT_SECRET=aurumsave_production_super_secret_jwt_encryption_key_2026
JWT_EXPIRES_IN=7d

# --- Payment Gateways & HMAC Webhook Verification ---
# Cryptographic signing secrets provided by Bangladesh MFS / Aggregators
PAYMENT_WEBHOOK_SECRET=aurumsave_webhook_signing_secret_dev_2026
BKASH_WEBHOOK_SECRET=bkash_ipn_signature_secret_sandbox_2026
NAGAD_WEBHOOK_SECRET=nagad_ipn_signature_secret_sandbox_2026
SSLCOMMERZ_STORE_PASSWORD=sslcommerz_store_secret_sandbox_2026

# --- Sandbox & Seed Protection ---
# Set to 'true' in development/staging to allow simulated checkouts. Must remain 'false' in production.
ALLOW_SANDBOX_PAYMENTS=true
# Guard against accidental DB wipes in production; must remain 'false' in production
ALLOW_PRODUCTION_SEED=false
