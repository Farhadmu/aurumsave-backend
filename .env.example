# --- Server & Core Runtime ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Database (Persistent MongoDB) ---
# In production, must be an authenticated persistent replica set or cluster URI
MONGODB_URI=mongodb://127.0.0.1:27017/aurumsave

# --- Authentication & Session Security ---
# In production, MUST be at least 32 cryptographically secure characters; insecure defaults rejected on startup
JWT_SECRET=aurumsave_production_super_secret_jwt_encryption_key_2026
JWT_EXPIRES_IN=7d

# --- Payment Gateways & Cryptographic Verification ---
# General webhook secret for development fallback
PAYMENT_WEBHOOK_SECRET=aurumsave_webhook_signing_secret_dev_2026

# bKash Tokenized Checkout & Webhook (Ref: https://developer.bka.sh/docs/tokenized-checkout)
BKASH_APP_KEY=your_bkash_app_key_placeholder
BKASH_APP_SECRET=your_bkash_app_secret_placeholder
BKASH_USERNAME=your_bkash_username_placeholder
BKASH_PASSWORD=your_bkash_password_placeholder
# Optional: PEM-encoded RSA public key provided by bKash for asymmetric webhook signature verification
BKASH_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----"

# Nagad Online Payment Integration (Ref: https://nagad.com.bd/merchant)
NAGAD_MERCHANT_ID=your_nagad_merchant_id_placeholder
# PEM-encoded RSA public key from Nagad Payment Gateway
NAGAD_PG_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A...\n-----END PUBLIC KEY-----"
# PEM-encoded RSA private key generated by merchant for Nagad integration
NAGAD_MERCHANT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEAz...\n-----END RSA PRIVATE KEY-----"

# SSLCommerz Hosted Checkout & Order Validation API (Ref: https://developer.sslcommerz.com/doc/v4/)
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id_placeholder
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password_placeholder

# --- Sandbox & Seed Protection ---
# Set to 'true' in development/staging to allow simulated checkouts. Must remain 'false' in production.
ALLOW_SANDBOX_PAYMENTS=true
# Guard against accidental DB wipes in production; must remain 'false' in production
ALLOW_PRODUCTION_SEED=false
